{
  "name": "nest-react-turbo-template",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:docker": "turbo run build:docker --filter=frontend --filter=backend --parallel",
    "build:frontend": "turbo run build --filter=frontend",
    "build:backend": "turbo run build --filter=backend",
    "build:frontend:docker": "turbo run build:docker --filter=frontend",
    "build:backend:docker": "turbo run build:docker --filter=backend",
    "start:frontend": "turbo run dev --filter=frontend",
    "start:backend": "turbo run dev --filter=backend",
    "start": "turbo run dev --filter=frontend --filter=backend --parallel",
    "start:all": "yarn docker:up && turbo run dev --filter=frontend --filter=backend --parallel",
    "test": "turbo run test",
    "test:frontend": "turbo run test --filter=frontend",
    "test:backend": "turbo run test --filter=backend",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "yarn docker:down && yarn docker:up",
    "setup:db": "yarn docker:up && bash ./scripts/setup_postgres.sh",
    "setup:db:local": "bash ./scripts/setup_db_local.sh",
    "start:with-setup": "yarn docker:restart && yarn setup:db && turbo run dev --filter=frontend --filter=backend --parallel",
    "start:local": "yarn setup:db:local && turbo run dev --filter=frontend --filter=backend --parallel",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean:install": "yarn install --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@swc/core": "1.3.50",
    "@swc/jest": "^0.2.38",
    "turbo": "^2.5.3",
    "unplugin-swc": "1.3.2",
    "vitest": "0.30.1"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.11",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.11",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "packageManager": "yarn@4.9.1"
}
