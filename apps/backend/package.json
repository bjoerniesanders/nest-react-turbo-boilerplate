{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "mikroorm": "mikro-orm",
    "migration:create": "npm run mikroorm migration:create",
    "migration:up": "npm run mikroorm migration:up",
    "migration:down": "npm run mikroorm migration:down",
    "build:docker": "docker build -f Dockerfile -t backend .",
    "build:swc": "swc src -d dist --config-file .swcrc",
    "docker:build": "docker build -f Dockerfile -t backend .",
    "docker:up": "docker-compose -f ../../docker-compose.yml up -d backend",
    "docker:down": "docker-compose -f ../../docker-compose.yml down",
    "mikro-orm": "mikro-orm",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker-compose -f docker-compose.test.yml down",
    "test:db:clean": "docker-compose -f docker-compose.test.yml down -v",
    "test:db:setup": "npm run test:db:up && NODE_ENV=test npm run mikro-orm schema:create",
    "test:db:teardown": "npm run test:db:down",
    "test:e2e:setup": "npm run test:db:setup && npm run test:e2e",
    "test:e2e:teardown": "npm run test:db:teardown",
    "test:db:local:setup": "./scripts/setup-test-db.sh",
    "test:e2e:local:setup": "npm run test:db:local:setup && NODE_ENV=test npm run mikro-orm schema:create && npm run build && NODE_ENV=test npm run test:e2e"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.16",
    "@mikro-orm/reflection": "^6.4.16",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.5",
    "@testing-library/dom": "^10.4.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "webpack": "^5.98.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@jest/globals": "^29.7.0",
    "@mikro-orm/cli": "^6.4.16",
    "@nestjs/cli": "^11.0.8",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.5",
    "@nestjs/typeorm": "^11.0.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.12.11",
    "@swc/jest": "^0.2.39",
    "@swc/register": "^0.1.10",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/passport": "^1.0.17 ",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1",
    "@types/pg": "^8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.4.0",
    "istanbul-badges-readme": "^1.9.0",
    "jest": "^29.7.0",
    "pg": "^8.15.6",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.25",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.5",
    "vite": "^7.0.6"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/vite",
      "**/vite/**",
      "**/vitest",
      "**/vitest/**"
    ]
  }
}
