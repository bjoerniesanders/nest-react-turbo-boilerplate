{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "build:docker": "docker build -f Dockerfile -t backend .",
    "build:swc": "swc src -d dist --config-file .swcrc",
    "start": "node dist/src/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "test:ui": "jest --coverage --coverage-report=html",
    "lint": "eslint .",
    "docker:build": "docker build -f Dockerfile -t backend .",
    "docker:up": "docker-compose -f ../../docker-compose.yml up -d backend",
    "docker:down": "docker-compose -f ../../docker-compose.yml down",
    "mikro-orm": "mikro-orm",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker-compose -f docker-compose.test.yml down",
    "test:db:clean": "docker-compose -f docker-compose.test.yml down -v",
    "test:db:setup": "npm run test:db:up && NODE_ENV=test npm run mikro-orm schema:create",
    "test:db:teardown": "npm run test:db:down",
    "test:e2e:setup": "npm run test:db:setup && npm run test:e2e",
    "test:e2e:teardown": "npm run test:db:teardown",
    "test:db:local:setup": "./scripts/setup-test-db.sh",
    "test:e2e:local:setup": "npm run test:db:local:setup && NODE_ENV=test npm run mikro-orm schema:create && npm run build && NODE_ENV=test npm run test:e2e"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.11",
    "@mikro-orm/migrations": "^6.4.11",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.11",
    "@mikro-orm/reflection": "^6.4.11",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@testing-library/dom": "^10.4.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "webpack": "^5.98.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@mikro-orm/cli": "^6.4.11",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.11",
    "@swc/jest": "^0.2.37",
    "@swc/register": "^0.1.10",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.11",
    "@types/passport": "^1.0.17 ",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "istanbul-badges-readme": "^1.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "unplugin-swc": "^1.5.1",
    "vite": "^6.2.2"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/vite",
      "**/vite/**",
      "**/vitest",
      "**/vitest/**"
    ]
  }
}
