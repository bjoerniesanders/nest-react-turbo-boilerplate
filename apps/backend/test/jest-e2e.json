{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": "<rootDir>/../tsconfig.test.json",
      "diagnostics": {
        "ignoreCodes": [151001]
      }
    }]
  },
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/../src/$1",
    "^@test/(.*)$": "<rootDir>/$1",
    "^mikro-orm.config$": "<rootDir>/../mikro-orm.config.ts",
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
  "injectGlobals": true,
  "testTimeout": 30000,
  "verbose": true
}
